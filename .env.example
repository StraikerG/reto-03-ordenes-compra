# Proveedor LLM: gemini o anthropic.
# La clave NUNCA va al repositorio, frontend, logs ni respuestas HTTP.
LLM_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Fallback opcional para Anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Topes de costo y protecciones del servidor.
MAX_ITER=25
MAX_TOKENS_SESSION=200000
MAX_TOKENS_GLOBAL=2000000
LLM_TIMEOUT_MS=60000
RATE_LIMIT_PER_MIN=30

PORT=3000